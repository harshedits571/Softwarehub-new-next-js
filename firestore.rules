rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    
    // Check if user is the Root Admin (harshks12345@gmail.com)
    function isRootAdmin() {
      return request.auth != null && request.auth.token.email == 'harshks12345@gmail.com';
    }

    // Check if user is an Admin (Role based)
    function isAdmin() {
      return isRootAdmin() || 
        (request.auth != null && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        ));
    }

    // Check if user is a Sub-Admin
    function isSubAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'sub-admin';
    }
    
    // Check if user is an Approved Creator
    function isApprovedCreator() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'creator' && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isCreatorApproved == true;
    }

    // Check if the current user owns the target UID
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ==========================================
    // EXISTING COLLECTIONS (100% PRESERVED)
    // ==========================================

    // 1. Users Collection
    match /users/{uid} {
      allow read: if isOwner(uid) || 
                     isAdmin() || 
                     isSubAdmin() ||
                     resource.data.role == 'creator';
      
      allow create: if isOwner(uid) && 
                    (!request.resource.data.keys().hasAny(['role', 'isAdmin', 'isCreatorApproved', 'isPaid', 'isBanned'])) || 
                    isAdmin();

      allow update: if (isOwner(uid) && 
                        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'allowedSections', 'isCreatorApproved', 'isPaid', 'isBanned']))) || 
                        isAdmin();
                        
      allow delete: if isAdmin();
    }

    // 1a. Customers Collection
    match /customers/{email} {
      allow read, write: if request.auth != null && request.auth.token.email == email;
      allow read, write: if isAdmin() || isSubAdmin();
    }

    // 2. Products Collection (All Marketplace Assets)
    match /products/{productId} {
      allow read: if true; 

      allow create: if isAdmin() || 
                    isSubAdmin() ||
                    (isApprovedCreator() && request.resource.data.creatorId == request.auth.uid && request.resource.data.status == 'pending');

      allow update: if isAdmin() ||
                    isSubAdmin() ||
                    (isApprovedCreator() && resource.data.creatorId == request.auth.uid && request.resource.data.creatorId == request.auth.uid);

      allow delete: if isAdmin() || isSubAdmin() || 
                    (isApprovedCreator() && resource.data.creatorId == request.auth.uid);
    }
    
    // 3. Settings & Config (Admin Panel)
    match /settings/{docId} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    // 4. Transactions Ledger
    match /transactions/{transactionId} {
      allow read: if isAdmin() || 
                     isSubAdmin() ||
                     (request.auth != null && resource.data.uid == request.auth.uid) ||
                     (request.auth != null && resource.data.vendorId == request.auth.uid);
      
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      
      allow update, delete: if isAdmin();
    }
    
    // 5. Download Logs Ledger
    match /downloadLogs/{logId} {
      allow read: if isAdmin() || isSubAdmin() || (request.auth != null && resource.data.uid == request.auth.uid) || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      
      allow update, delete: if isAdmin();
    }
    
    // 6. Ratings & Reviews
    match /ratings/{ratingId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin();
    }
    
    // 7. Ratings Summary / Product Stats
    match /ratingsSummary/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /product_stats/{productId} {
      allow read: if true;
      allow write: if request.auth != null; 
    }

    // 8. Feedback / Broken Link Reports
    match /brokenLinkReports/{reportId} {
      allow read: if isAdmin() || isSubAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // 9. Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin() || isSubAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // 10. Banners
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin() || isSubAdmin();
    }

    // 11. User Messages (Contact Form)
    match /userMessages/{messageId} {
      allow read: if isAdmin() || isSubAdmin();
      allow create: if true;
      allow update, delete: if isAdmin() || isSubAdmin();
    }

    // 12. Product Reviews
    match /productReviews/{reviewId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin();
    }
    
    // 13. Storage Audits
    match /storageAudits/{auditId} {
      allow read: if isAdmin() || isSubAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // PERSONAL STORAGE / PERSONAL CLOUD (NEW)
    // ==========================================

    // 14. Leads & Customers
    match /leads/{leadId} {
      allow create: if true; // Checkout modal marks leads as Interested
      allow read, update, delete: if isAdmin() || isSubAdmin();
    }

    // 15. Payments
    match /payments/{paymentId} {
      allow create: if true; // Checkout writes transaction record
      allow read, update, delete: if isAdmin() || isSubAdmin();
    }

    // 16. Licensing
    match /licenses/{licenseKey} {
      allow get: if true; // Windows desktop client checks license validity
      allow list: if isAdmin() || isSubAdmin();
      allow create: if true;
      allow update, delete: if isAdmin() || isSubAdmin() || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['devices', 'activatedMachines', 'boundMachines', 'lastActiveAt', 'lastUsed']));
    }

    // 17. Custom Links (Influencers / Affiliates / Campaigns)
    match /custom_links/{linkCode} {
      allow read: if true; // Public storefront checks promotional link codes
      allow update: if isAdmin() || isSubAdmin() || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'successfulPurchases', 'currentRedemptions', 'revenueGenerated', 'totalSalesINR']));
      allow create, delete: if isAdmin() || isSubAdmin();
    }

    // 18. Config (Pricing Management & Software Updates)
    match /config/{docId} {
      allow read: if true; // Public storefront reads live prices & desktop checks updates
      allow write: if isAdmin() || isSubAdmin();
    }

    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isSubAdmin();
    }

    match /coupons/{code} {
      allow read: if true;
      allow write: if isAdmin() || isSubAdmin();
    }

    // 19. Cloud Gateways (Live Tunnel & Remote Handshake for Personal Cloud)
    match /cloud_gateways/{licenseKey} {
      allow read, write: if true;
    }
  }
}

